--!nocheck
-- m3-plan-r2 (from the first plan's proto/dump_fixtures.luau): the prototype's fixtures (docs/spec/prototypes/S2/v2/
-- fixtures.luau) as literal PartData rows ready to paste into tests/fixtures (Build.part rows), with the bits this
-- machine's Lune computes for every trigonometric value. Per fixture: part count, smallest side, margin to the Sword
-- hitbox (the snapshot's Shapes.prepare AABB), the snapshot's verdict (valid, cleaned ids) and its d per step in the
-- measure's rank order through the emulator, and whether a rotation is not one of Build's named ones (then the literal
-- must be pasted, never recomputed in a fixture module).
--   lune run <abs>/proto/dump_fixtures.luau > fixtures_literals.txt
local L = require("./lib")
local Fx = L.Fx
local BShapes = L.BShapes
local fmt = string.format

-- the shortest decimal that reads back to the same double
local function num(x)
	if x == 0 then
		return "0"
	end
	for digits = 1, 17 do
		local s = fmt("%." .. digits .. "g", x)
		if tonumber(s) == x then
			return s
		end
	end
	return fmt("%.17g", x)
end
local function vec(v)
	local t = {}
	for i = 1, #v do
		table.insert(t, num(v[i]))
	end
	return "{ " .. table.concat(t, ", ") .. " }"
end

local R, S, C = 0.70710678118654757, 0.38268343236508978, 0.92387953251128674
local NAMED = {
	{ "I", { 0, 0, 0, 1 } },
	{ "Z45", { 0, 0, S, C } },
	{ "Z90", { 0, 0, R, R } },
	{ "Y90", { 0, R, 0, R } },
	{ "Y45", { 0, S, 0, C } },
	{ "Z180", { 0, 0, 1, 0 } },
	{ "YM90", { 0, -R, 0, R } }, -- new: Build.YM90, the prototype's RY_M90 (the tips' rotation)
}
local function rot(q)
	for _, n in ipairs(NAMED) do
		local a = n[2]
		if a[1] == q[1] and a[2] == q[2] and a[3] == q[3] and a[4] == q[4] then
			return n[1]
		end
	end
	return vec(q)
end

local function margin(b)
	local m, side = math.huge, math.huge
	for i, raw in ipairs(b.parts) do
		local p = BShapes.prepare(raw, i)
		m = math.min(m, p.minx + 0.8, 0.8 - p.maxx, p.miny - 0.0, 5.0 - p.maxy, p.minz + 0.3, 0.3 - p.maxz)
		side = math.min(side, raw.size[1], raw.size[2], raw.size[3])
	end
	return m, side
end

print("-- m3-plan-r2: the prototype's fixtures as Build.part rows (P = Build.part). Generated by proto-r2/dump_fixtures.luau")
print("-- on the M2 snapshot; d is the emulator's in the measure's rank order. Rotations named as Build's (YM90 is new).")
for _, f in ipairs(L.fixtures()) do
	local b = f.b
	local Rr = L.run(L.inRankOrder(b))
	local m, side = margin(b)
	local named = true
	for _, p in ipairs(b.parts) do
		if string.sub(rot(p.rot), 1, 1) == "{" then
			named = false
		end
	end
	local d = if Rr.steps then (L.dline(Rr)) else "invalid"
	print(fmt("-- %s %s: %d parts, min side %s, hitbox margin %s%s, valid=%s cleaned %s, d %s%s", f.id, b.name, #b.parts, num(side),
		num(m), if m < 0.02 - 1e-12 then " (< 0.02)" else "", tostring(Rr.valid), L.cleanedLine(Rr), d,
		if named then "" else ", pasted rotations"))
	print(fmt('["%s"] = {', f.id))
	for _, p in ipairs(b.parts) do
		print(fmt('\tP(%d, "%s", "%s", "%s", %s, %s, %s), -- %s', p.id, p.slot, p.shape, p.material, vec(p.pos), rot(p.rot),
			vec(p.size), p.label or ""))
	end
	print("},")
end

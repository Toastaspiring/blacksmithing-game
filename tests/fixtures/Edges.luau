-- S2's EdgeChain and the edge PrepareInput carries (Minigames/Types; a fixture cannot require src/)
export type EdgeChain = { points: { { number } }, length: number }
export type Edge = { name: string, chains: { EdgeChain }, gripPoint: { number }, gripAxis: { number } }

local function edge(name: string, points: { { number } }, length: number, gripAxis: { number }): Edge
	return { name = name, chains = { { points = points, length = length } }, gripPoint = { 0, 0.88, 0 }, gripAxis = gripAxis }
end


-- (tests/golden/minigames.bv1.golden.txt, written by Minigames/Minigames) judge these bytes, never a live bot run,
-- so the golden pins the judge, which is authoritative and uses no libm, and not this machine's C runtime, which the
-- bots use (Box–Muller, the OU process). One timeline per family × tier × profile: Iron, every factor at the tier's
-- BOT_REF_X, the trace on Edges.arming, HoldZone's pump policy, timingOffsetMs 0; the pattern seed Bots.seedOf(1, 1)
-- and the bot seed 1·7919 + 1·31 + 17, so each is run 1 of its cell of the shipped S3-score-distributions.luau.
-- Made once, on 19 Nov 2026, with Bots.play and Minigames.encode (M4 builder 4's gentimelines.luau); each judges Ok
-- at its cell's first score. Minigames/Bots checks that Bots.play still makes them byte for byte, beside a libm
-- canary. Regenerate only after a reviewed change of the bots (or of the libm: the canary says which), then re-bless
-- golden (b).
--
--   entries     { family, tier, material, profile, x, seed, botSeed, hex }, by family, tier and profile
--   hex(b)      a buffer as lowercase hex;   bytes(hex)   the buffer back

local Build = require("./Build")

export type Entry = {
	family: string,
	tier: string,
	material: string,
	profile: string,
	x: number,
	seed: number,
	botSeed: number,
	hex: string,
}

local MinigameTimelines = {}

function MinigameTimelines.hex(b: buffer): string
	local parts = table.create(buffer.len(b))
	for i = 0, buffer.len(b) - 1 do
		parts[i + 1] = string.format("%02x", buffer.readu8(b, i))
	end
	return table.concat(parts)
end

function MinigameTimelines.bytes(hex: string): buffer
	local b = buffer.create(#hex // 2)
	for i = 0, buffer.len(b) - 1 do
		buffer.writeu8(b, i, tonumber(string.sub(hex, 2 * i + 1, 2 * i + 2), 16) :: number)
	end
	return b
end


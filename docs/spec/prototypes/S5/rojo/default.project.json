          "$path": "src/client"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "BlacksmithServer": {
        "$path": "src/server",
        "Vendor": {
          "$className": "Folder",
          "ProfileStore": {
            "$path": "vendor/ProfileStore/ProfileStore.luau"
          }
        }
      }

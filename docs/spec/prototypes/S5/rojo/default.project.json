{
  "name": "BlacksmithingGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Blacksmith": {
        "$path": "src/shared",
        "Remotes": {
          "$className": "Folder",
          "Profile": { "$className": "RemoteEvent" },
          "Blueprint": { "$className": "RemoteEvent" },
          "Craft": { "$className": "RemoteEvent" },
          "Showcase": { "$className": "RemoteEvent" }
        }
      }
    },

    "StarterPlayer": {

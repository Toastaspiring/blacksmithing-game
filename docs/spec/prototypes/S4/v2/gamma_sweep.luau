--!strict
-- S4 prototype v2: score vs design difficulty inside a tier, with S3's final minigame code and bots (proto/S3/v2).
-- Every factor of the step's weight list is set to x, so the step's D = x (S2's weights sum to 1, m = 0 in the MVP).
-- Common random numbers: run i uses the same pattern seed and bot seed at every x (Sim.seedOf(i, 1)).
-- usage: lune run gamma_sweep.luau [nTsHz] [nPt]   -> out/gamma_data.luau, out/gamma_sweep.txt
local Sim = require("../../S3/v2/Sim")
local fs = require("@lune/fs")
local process = require("@lune/process")

local N_FAST = tonumber(process.args[1]) or 1000
local N_PT = tonumber(process.args[2]) or 600
local PHI = 0.75
local PASS = 0.5

local FAMS = { "HoldZone", "TimingStrike", "PrecisionTrace" }
local MATS = { "Iron", "Steel" }
local PROFS = { "Elite", "Good", "Average", "Poor" }
local XS = {
	Normal = { 0.0, 0.1, 0.1999 },
	Hard = { 0.2, 0.3, 0.45, 0.6, 0.8, 1.0 },
}

local lines: { string } = {}
local function out(s: string)
	print(s)
	table.insert(lines, s)
end

local data: { string } = {}
table.insert(data, "--!strict\n-- GENERATED by gamma_sweep.luau: mean raw score, pass rate, mean effective score (phi 0.75) per cell\nreturn {\n")
local t0 = os.clock()
out(string.format("# score vs D (= x), n = %d (HZ, TS) / %d (PT); cell = mean raw / pass %% / mean s_eff", N_FAST, N_PT))
for _, fam in FAMS do
	for _, mat in MATS do
		for _, prof in PROFS do
			local row = {}
			for _, tier in { "Normal", "Hard" } do
				for _, x in XS[tier] do
					local n = if fam == "PrecisionTrace" then N_PT else N_FAST
					local s, p = Sim.run({ family = fam, material = mat, tier = tier, profile = prof, x = x, n = n,
						policy = if fam == "HoldZone" then "pump" else nil })
					local sum, pass, eff = 0, 0, 0
					for i, v in s do
						sum += v
						local ok = v >= PASS
						if ok then
							pass += 1
							eff += v
						else
							eff += v * PHI
						end
						assert(ok == p[i] or v ~= v, "pass rule mismatch")
					end
					local mean, pr, me = sum / n, pass / n, eff / n
					table.insert(row, string.format("%s %.2f: %.4f/%.1f/%.4f", string.sub(tier, 1, 1), x, mean, pr * 100, me))
					table.insert(data, string.format("\t{ family = %q, material = %q, profile = %q, tier = %q, x = %.4f, n = %d, mean = %.5f, pass = %.5f, eff = %.5f },\n",
						fam, mat, prof, tier, x, n, mean, pr, me))
				end
			end
			out(string.format("%s %s %s | %s", fam, mat, prof, table.concat(row, " | ")))
		end
	end
end
table.insert(data, "}\n")
out(string.format("(%.1f s)", os.clock() - t0))
fs.writeFile("out/gamma_data.luau", table.concat(data))
fs.writeFile("out/gamma_sweep.txt", table.concat(lines, "\n") .. "\n")

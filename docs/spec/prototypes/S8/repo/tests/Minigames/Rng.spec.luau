--!strict
local Test = require("../lib/Test")
local A = require("../lib/Assert")
local Rng = require("../../src/shared/Minigames/Rng")

-- Known-answer vectors, generated by an independent Python reference
-- (proto/S8/studies/kat_xorshift32.py). Exact integer comparison.
local KAT: { { seed: number, out: { number } } } = {
	{ seed = 0, out = { 1085196063, 2447379481, 2618286376, 1701901981, 265159372 } },
	{ seed = 1, out = { 270369, 67634689, 2647435461, 307599695, 2398689233 } },
	{ seed = 42, out = { 11355432, 2836018348, 476557059, 3648046016, 3759983556 } },
	{ seed = 0xDEADBEEF, out = { 1199382711, 2384302402, 3129746520, 4276113467, 1745748808 } },
	{ seed = 0xFFFFFFFF, out = { 253983, 4228382207, 1958451267, 4056713434, 2049502865 } },
}

return Test.suite("Minigames/Rng", function(t)
	t.it("matches known-answer vectors", function()
		for _, v in KAT do
			local r = Rng.new(v.seed)
			for i, expected in v.out do
				A.eq(Rng.nextU32(r), expected, string.format("seed %d output %d", v.seed, i))
			end
		end
	end)

	t.it("same seed gives an identical stream", function()
		local a, b = Rng.new(123456789), Rng.new(123456789)
		for i = 1, 10000 do
			A.eq(Rng.nextU32(a), Rng.nextU32(b), "draw " .. i)
		end
	end)

	t.it("rejects seeds bit32 would silently coerce", function()
		for _, bad in { 0 / 0, math.huge, -1, 1.5, 2 ^ 32, -0.5 } do
			A.throws(function() Rng.new(bad) end, "seed must be an integer", tostring(bad))
		end
	end)

	t.it("nextFloat stays in [0, 1) and nextInt in [lo, hi] covering every value", function()
		local r = Rng.new(7)
		local seen: { [number]: boolean } = {}
		for _ = 1, 5000 do
			local f = Rng.nextFloat(r)
			A.truthy(f >= 0 and f < 1, "float out of range: " .. f)
			local n = Rng.nextInt(r, -3, 3)
			A.within(n, -3, 3)
			seen[n] = true
		end
		for v = -3, 3 do
			A.truthy(seen[v], "value never drawn: " .. v)
		end
	end)

	t.slow("uniform: chi-square over 16 buckets below the p=0.001 critical value", function()
		for _, seed in { 1, 2, 3, 0xC0FFEE } do
			local r = Rng.new(seed)
			local buckets = table.create(16, 0)
			local n = 160000
			for _ = 1, n do
				local b = bit32.rshift(Rng.nextU32(r), 28) + 1
				buckets[b] += 1
			end
			local expected, chi2 = n / 16, 0
			for _, c in buckets do
				chi2 += (c - expected) * (c - expected) / expected
			end
			A.truthy(chi2 < 37.70, string.format("seed %d chi2=%.2f (df=15, crit 37.70)", seed, chi2))
		end
	end)

	t.it("derived step seeds are deterministic and distinct per salt", function()
		local seen: { [number]: number } = {}
		for salt = 1, 1000 do
			local s = Rng.derive(0xABCDEF01, salt)
			A.eq(s, Rng.derive(0xABCDEF01, salt))
			A.falsy(seen[s], "collision between salts " .. tostring(seen[s]) .. " and " .. salt)
			seen[s] = salt
		end
	end)
end)
